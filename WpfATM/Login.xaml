<Window x:Class="WpfATM.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfATM"
        Loaded="Login_OnLoaded"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800" BorderBrush="Black" BorderThickness="1">
        <Window.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#ECF9EF" Offset="0.0" />
                <GradientStop Color="#C9EED3" Offset="0.1"/>
                <GradientStop Color="#A6E3B7" Offset="0.2"/>
                <GradientStop Color="#83D89B" Offset="0.3"/>
                <GradientStop Color="#60CD7F" Offset="0.4"/>
                <GradientStop Color="#3DC263" Offset="0.5"/>
                <GradientStop Color="#329F51" Offset="0.6"/>
                <GradientStop Color="#236E38" Offset="0.7"/>
                <GradientStop Color="#1C592D" Offset="0.8"/>
                <GradientStop Color="#11361C" Offset="0.9"/>
                <GradientStop Color="#06130A" Offset="1.0"/>
            </LinearGradientBrush>
        </Window.Background>
    
    <Viewbox Stretch="Uniform">
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56.25" />
            <RowDefinition Height="56.25" />
            <RowDefinition Height="56.25" />
            <RowDefinition Height="56.25" />
            <RowDefinition Height="56.25" />
            <RowDefinition Height="56.25" />
            <RowDefinition Height="56.25" />
            <RowDefinition Height="56.25" />
        </Grid.RowDefinitions>
        
        <Rectangle Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="8" Fill="WhiteSmoke" Stroke="Black" StrokeThickness="3" RadiusX="5" RadiusY="5">
            <Rectangle.Effect>
                <DropShadowEffect Color="Black" ShadowDepth="10" BlurRadius="10" Opacity="0.5"/>
            </Rectangle.Effect>
        </Rectangle>
        
        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" TextAlignment="Center" VerticalAlignment="Center" FontSize= "32" FontWeight="Bold" Text="Please enter your Data."/>
        <TextBlock Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" TextAlignment="Right" VerticalAlignment="Center" FontSize="18" Text="Bank Provider:"/>
        <ComboBox Grid.Column="2" Grid.Row="2" Grid.RowSpan="2" IsEditable="False" FontSize="18" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Center" >
            <ComboBoxItem Content="Bank1"/>
            <ComboBoxItem Content="Bank2"/>
            <ComboBoxItem Content="Bank3"/>
        </ComboBox>
        <TextBlock Grid.Column="1" Grid.Row="3" Grid.RowSpan="2" TextAlignment="Right" VerticalAlignment="Center" FontSize="18" Text="PIN:"/>
        <TextBox Grid.Column="2" Grid.Row="3" Grid.RowSpan="2" TextAlignment="Left" VerticalAlignment="Center" FontSize="18" Width="100" MaxLength="4" Name="PinTextBox"/>
        
        <Button Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Padding="6" Click="ValidatePinAndLogIn">Log In</Button>
        <Button Grid.Column="2" Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Padding="6" Click="OpenCreateAccountWindowClick">Create Account</Button>
        <Button Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Padding="6" Click="ButtonExit_OnClick">Exit</Button>
        
        <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="7" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="12" Padding="5" Text="©2006-2026 Global Evil ABZ Conglomerate Gmbh" />
    </Grid>
    </Viewbox>
</Window>
